# Sanad API local settings.
#
# Copy this file to apps/api/.env and fill in what you need:
#     cp apps/api/.env.example apps/api/.env
# Git ignores .env. Never put a real key or password in this example file, and never commit .env.
# A variable set in your shell wins over the value in .env. Empty values count as unset.
# Synthetic data only: this is a research prototype, not a medical device.

# --- Storage --------------------------------------------------------------------------------
SANAD_DATABASE_URL=sqlite:///./sanad-dev.db

# --- Simulated staff sign-in (local only; leave empty to disable that sign-in) --------------
SANAD_DEMO_REVIEWER_PASSWORD=
SANAD_DEMO_MOCK_FACILITY_PASSWORD=

# --- Chat answer matching with Azure OpenAI (RF-21, optional, off by default) ---------------
# "disabled" makes no model call. "azure_openai" sends typed chat text and the current question
# to your Azure OpenAI resource. Not yet approved for demos (CC-011): synthetic text only.
# Needs the optional extra: pip install -e 'apps/api[azure]'
SANAD_MODEL_PROVIDER=disabled

# Endpoint from the Azure portal > your resource > Keys and Endpoint. Either host form works:
#   https://<your-resource>.services.ai.azure.com/openai/v1   (AI Foundry)
#   https://<your-resource>.openai.azure.com                  (Azure OpenAI)
# "/openai/v1" is added when it is missing; no api-version is used.
SANAD_AZURE_OPENAI_ENDPOINT=https://agent-foundry-2.services.ai.azure.com/openai/v1

# The deployment name you chose, not the model name. Use a model that supports structured outputs.
SANAD_AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

# "entra_id" uses DefaultAzureCredential (az login locally, or a managed identity when hosted)
# and needs no key; the identity needs the "Cognitive Services OpenAI User" role.
# "api_key" uses the key below instead.
SANAD_AZURE_OPENAI_AUTH=entra_id
SANAD_AZURE_OPENAI_API_KEY=

# Optional limits. Engineering defaults, TECH_TBD.
# SANAD_MODEL_TIMEOUT_MS=12000
# SANAD_MODEL_MAX_ATTEMPTS=2
# SANAD_MODEL_MAX_COMPLETION_TOKENS=800
